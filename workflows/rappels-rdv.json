      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "id": "3120e1e4-d055-45b0-95f5-b67a639e9598",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  r.id AS rdv_id,\n  r.date_rdv,\n  p.prenom,\n  p.email,\n  p.telephone\nFROM rendez_vous r\nJOIN patients p ON p.id = r.patient_id\nWHERE r.statut = 'confirme'\n  AND r.rappel_email_envoye_at IS NULL\n  AND r.date_rdv >= CURRENT_DATE + 1\n  AND r.date_rdv <  CURRENT_DATE + 2\nORDER BY r.date_rdv;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "1f288e0e-67fb-4724-a37d-60ae9ec24d65",
      "name": "Rendez-vous de demain",
      "credentials": {
        "postgres": {
          "id": "FoWChcvSfrRo1pKi",
          "name": "DentIA Postgres"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "DentIA <mariemtoumi44@gmail.com>",
        "toEmail": "={{ $json.email }}",
        "subject": "Rappel : votre rendez-vous de demain",
        "html": "=<p>Bonjour {{ $json.prenom }},</p>\n\n<p>Nous vous rappelons votre rendez-vous au cabinet dentaire :\n<strong>{{ new Date($json.date_rdv).toLocaleString('fr-FR', { timeZone: 'Africa/Tunis', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) }}</strong>.</p>\n\n<p>Si vous ne pouvez pas venir, merci de nous prévenir dès que possible.</p>\n\n<p>À bientôt,<br>L'équipe DentIA</p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
