      ],
      "id": "cd6540e5-80e9-4104-9a37-239f5bc5c17f",
      "name": "Détails des articles"
    },
    {
      "parameters": {
        "jsCode": "// Transforme la réponse PubMed (esummary) en une liste HTML lisible pour l'email\nconst data = $input.first().json;\nconst result = data.result || {};\nconst uids = result.uids || [];\n\n// Évite les problèmes si un titre contient < > ou &\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst articles = uids.map((uid) => {\n  const a = result[uid] || {};\n  return {\n    pmid: uid,\n    titre: String(a.title || 'Sans titre').replace(/\\.$/, ''),\n    revue: a.source || '',\n    date: a.pubdate || '',\n    lien: `https://pubmed.ncbi.nlm.nih.gov/${uid}/`,\n  };\n});\n\n// Aucune publication cette semaine : on arrête ici, aucun email n'est envoyé\nif (articles.length === 0) return [];\n\nconst html = '<ul style=\"padding-left:18px\">' + articles.map((a) =>\n  `<li style=\"margin-bottom:14px\">` +\n  `<a href=\"${a.lien}\"><b>${esc(a.titre)}</b></a><br>` +\n  `<span style=\"color:#555\"><i>${esc(a.revue)}</i>, ${esc(a.date)}</span>` +\n  `</li>`\n).join('') + '</ul>';\n\nreturn [{ json: { nombre: articles.length, articles, html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        0
      ],
      "id": "b2315280-64c0-415d-a8a7-e2d88f34b23b",
