        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:640px\">\n  <h2>Veille scientifique DentIA</h2>\n  <p>Voici les {{ $json.nombre }} publications les plus récentes sur l'IA en médecine dentaire (7 derniers jours, source : PubMed).</p>\n  {{ $json.html }}\n  <p style=\"color:#888;font-size:12px\">Message automatique envoyé par DentIA.</p>\n</div>",
        "options": {}
